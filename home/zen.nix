{ config, inputs, ... }:

let
  profile = "default";
  # Existing profile dir Zen already uses (holds tabs, logins, mods).
  profilePath = "balb4vgo.Default (release)";
in
{
  imports = [ inputs.zen-browser.homeModules.beta ];

  # Profile lives in ~/.config/zen (releases >= 1.18.6b moved it from ~/.zen).
  # Close Zen before switching, or declared spaces/pins/etc. are skipped with a warning.
  programs.zen-browser = {
    enable = true;

    # Dux Shell themes Zen with its own matugen template (Settings > Theme &
    # Apps > zenbrowser): it writes ~/.config/dms/zen.css on every theme change.
    # As in the Dux docs, userChrome.css is a link to it (below); the pref makes
    # Zen load userChrome.css at all.
    profiles.${profile} = {
      id = 0;
      isDefault = true;
      path = profilePath;
      settings."toolkit.legacyUserProfileCustomizations.stylesheets" = true;
    };

    # Pywalfox (Firefox-style theming) is not used with Zen; kept for reference.
    # nativeMessagingHosts = [
    #   (pkgs.writeTextDir "lib/mozilla/native-messaging-hosts/pywalfox.json" (
    #     builtins.toJSON {
    #       name = "pywalfox";
    #       description = "Automatically theme your browser using the colors generated by Pywal";
    #       path = "${pkgs.pywalfox-native}/bin/pywalfox";
    #       type = "stdio";
    #       allowed_extensions = [ "pywalfox@frewacom.org" ];
    #     }
    #   ))
    # ];
    # policies.ExtensionSettings."pywalfox@frewacom.org" = {
    #   install_url = "https://addons.mozilla.org/firefox/downloads/latest/pywalfox/latest.xpi";
    #   installation_mode = "normal_installed";
    # };
  };

  # Live link (not a store copy) so Dux's regenerated colors apply on restart.
  home.file."${config.programs.zen-browser.configPath}/${profilePath}/chrome/userChrome.css".source =
    config.lib.file.mkOutOfStoreSymlink "${config.xdg.configHome}/dms/zen.css";
}
