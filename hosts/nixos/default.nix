{ pkgs, ... }:

{
  imports = [
    # Generated by nixos-generate-config; kept at the repo root, not edited.
    ../../hardware-configuration.nix
    ../../modules/nixos
  ];

  networking.hostName = "nixos"; # must match the flake attribute
  time.timeZone = "Asia/Dhaka";
  i18n.defaultLocale = "en_US.UTF-8";

  # hidraw access for the keyboard/mouse config apps. TAG+="uaccess" only works
  # before 73-seat-late.rules, so these can't go in services.udev.extraRules
  # (that is 99-local.rules, too late for the ACL to be applied).
  services.udev.packages = [
    (pkgs.writeTextDir "lib/udev/rules.d/70-hid-dongles.rules" ''
      # Keyboard dongle
      KERNEL=="hidraw*", ATTRS{idVendor}=="258a", ATTRS{idProduct}=="010c", MODE="0660", TAG+="uaccess"

      # ATK / VXE vendor HID configuration collections.
      # The app only needs access to the 0xff02:0002 collection, but hidraw nodes are
      # enumerated per interface, so grant the logged-in user access to the vendor's
      # HID devices. Reconnect the mouse or receiver after installing this rule.
      SUBSYSTEM=="hidraw", ATTRS{idVendor}=="373b", TAG+="uaccess", MODE="0660"
      SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3554", TAG+="uaccess", MODE="0660"
    '')
  ];

  # Keep the original value from your install; don't bump it.
  system.stateVersion = "26.05";
}
